{
  "name": "drop-den-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:dev": "cd .. && frontend/node_modules/.bin/tauri dev",
    "desktop:build": "cd .. && frontend/node_modules/.bin/tauri build",
    "desktop:prepare": "../scripts/prepare-tauri-sidecar.sh",
    "desktop:dev:sidecar": "../scripts/prepare-tauri-sidecar.sh && cd .. && frontend/node_modules/.bin/tauri dev",
    "desktop:build:sidecar": "../scripts/prepare-tauri-sidecar.sh && cd .. && frontend/node_modules/.bin/tauri build",
    "desktop:package": "cd .. && ./scripts/build-desktop.sh",
    "dev:desktop-api": "DROP_DEN_API_TARGET=http://127.0.0.1:18080 yarn dev"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-react": "^6.0.1",
    "lucide-react": "^1.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4"
  }
}
