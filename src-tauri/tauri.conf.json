{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drop Den",
  "version": "0.1.0",
  "identifier": "com.dropden.app",
  "build": {
    "beforeDevCommand": "cd ../frontend && yarn dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../frontend && yarn build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Drop Den",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local-only file and message transfer hub",
    "longDescription": "Drop Den is a local-only browser-based file and message transfer hub for nearby devices.",
    "externalBin": ["binaries/drop-den-backend"],
    "icon": ["icons/icon.png"]
  }
}
